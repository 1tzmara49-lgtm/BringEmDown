<Defs>
  <SitePartDef Name="BED_CrashedShip">
    <defName>BED_CrashedShip</defName>
    <label>crashed ship</label>
    <description>A small chunk of a large trader ship.</description>
    <workerClass>SitePartWorker_Outpost</workerClass>
    <siteTexture>World/WorldObjects/Sites/Outpost</siteTexture>
    <expandingIconTexture>World/WorldObjects/Expanding/Sites/Outpost</expandingIconTexture>
    <applyFactionColorToSiteTexture>true</applyFactionColorToSiteTexture>
    <showFactionInInspectString>true</showFactionInInspectString>
    <requiresFaction>true</requiresFaction>
    <approachOrderString>Attack {0}</approachOrderString>
    <approachingReportString>Attacking {0}.</approachingReportString>
    <arrivedLetter>There is ship debris in this area.</arrivedLetter>
    <arrivedLetterDef>NegativeEvent</arrivedLetterDef>
    <wantsThreatPoints>true</wantsThreatPoints>
    <gravShipsCanLandOn>true</gravShipsCanLandOn>
    <minThreatPoints>300</minThreatPoints>
    <excludesTags>
      <li>MechCluster</li>
      <li>MechClusterForceNoConditionCauser</li>
      <li>SleepingMechanoids</li>
      <li>Manhunters</li>
    </excludesTags>
  </SitePartDef>

  <GenStepDef>
    <defName>BED_GenStep_ScatterSteelSlag</defName>
    <linkWithSite>BED_CrashedShip</linkWithSite>
    <order>480</order>
    <genStep Class="GenStep_ScatterThings">
      <thingDef>ChunkSlagSteel</thingDef>
      <countPer10kCellsRange>10.0~20.0</countPer10kCellsRange>
    </genStep>
  </GenStepDef>

  <GenStepDef>
    <defName>BED_GenStep_ScatterShipChunks</defName>
    <linkWithSite>BED_CrashedShip</linkWithSite>
    <order>500</order>
    <genStep Class="GenStep_ScatterThings">
      <thingDef>ShipChunk</thingDef>
      <countPer10kCellsRange>5.0~10.0</countPer10kCellsRange>
    </genStep>
  </GenStepDef>

  <GenStepDef>
    <defName>BED_Generate_Survivors</defName>
    <linkWithSite>BED_CrashedShip</linkWithSite>
    <order>550</order>
    <genStep Class="BringEmDown.GenerateSurvivors">
  </GenStepDef>
</Defs>