<Defs>
<!-- im going to kill every person who says i vibecoded this shit just because of the comments -->

<!-- the railcannon (gun, yes im putting it in the buildings def, no im not making a separate file just for this.)-->

  <!-- the gun itself -->

    <ThingDef ParentName="BaseWeaponTurret">
    <defName>BED_OrbitalRailcannon_Gun</defName>
    <label>railcannon</label>
    <description>A large cannon designed for firing high velocity armor piercing rails. Can target both on-ground threats and targets in orbit.</description>
    <graphicData>
      <texPath>Building/Railcannon/RailcannonGun</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <AccuracyTouch>0.0</AccuracyTouch>
      <AccuracyShort>0.1</AccuracyShort>
      <AccuracyMedium>0.76</AccuracyMedium>
      <AccuracyLong>0.95</AccuracyLong>
      <RangedWeapon_Cooldown>60.5</RangedWeapon_Cooldown>
      <DeteriorationRate>0</DeteriorationRate>
      <Mass>90</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <defaultProjectile>Bullet_AutocannonTurret</defaultProjectile>
        <warmupTime>10</warmupTime>
        <minRange>20.0</minRange>
        <range>70.0</range>
        <soundCast>Shot_Autocannon</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>24</muzzleFlashScale>
        <consumeFuelPerShot>1</consumeFuelPerShot>
      </li>
    </verbs>
  </ThingDef>

  <!-- the base -->
  
  <ThingDef ParentName="BuildingBase" Name="RailcannonTurret" Abstract="True"> 
    <thingClass>Building_TurretGun</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <drawHighlight>true</drawHighlight>
    <drawHighlightOnlyForHostile>true</drawHighlightOnlyForHostile>
    <graphicData>
      <texPath>Things/Building/Security/TurretHeavy_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.5, 1.5)</drawSize>
      <drawOffset>(0,0,-0.1)</drawOffset>
      <damageData>
        <rect>(0.2,0.2,0.6,0.6)</rect>
      </damageData>
      <shadowData>
        <volume>(1.5,0.35,1.4)</volume>
        <offset>(0,0,-0.05)</offset>
      </shadowData>
    </graphicData>    
    <altitudeLayer>Building</altitudeLayer>
    <stealable>false</stealable>
    <rotatable>false</rotatable>
    <size>(2,2)</size>
    <statBases>
      <MaxHitPoints>380</MaxHitPoints>
      <Flammability>0.7</Flammability>
      <WorkToBuild>15000</WorkToBuild>
      <Mass>100</Mass>
      <Beauty>-20</Beauty>
    </statBases>
    <tickerType>Normal</tickerType>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <hasTooltip>true</hasTooltip>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <designationCategory>Security</designationCategory>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <building>
      <ai_combatDangerous>true</ai_combatDangerous>
      <turretTopDrawSize>2.7</turretTopDrawSize>
      <turretTopOffset>(0, 0.05)</turretTopOffset>
    </building>
    <placeWorkers>
      <li>PlaceWorker_TurretTop</li>
      <li>PlaceWorker_ShowTurretRadius</li>
    </placeWorkers>
    <designationHotKey>Misc3</designationHotKey>    
    <uiIconScale>0.95</uiIconScale>
    <comps>
      <li Class="CompProperties_Stunnable">
        <affectedDamageDefs>
          <li>Stun</li>
          <li>EMP</li>
        </affectedDamageDefs>
      </li>
    </comps>
  </ThingDef>
  
  <ThingDef ParentName="RailcannonTurret">
    <defName>BED_OrbitalRailcannon</defName>
    <label>orbital railcannon</label>
    <description>TBD</description>
    <graphicData>
      <texPath>placeholderpng</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
      <damageData>
        <rect>(0,0,3,1.8)</rect>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
      <shadowData>
        <volume>(2,3,2)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <blockWind>true</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <fillPercent>0.5</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>2200</WorkToBuild>
      <Flammability>0.6</Flammability>
    </statBases>
    <size>(2,2)</size>
    <building>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
      <turretGunDef>BED_OrbitalRailcannon_Gun</turretGunDef>
    </building>
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <defaultPlacingRot>North</defaultPlacingRot>
    <interactionCellOffset>(0,0,2)</interactionCellOffset>
    <hasInteractionCell>true</hasInteractionCell>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <designationCategory>Misc</designationCategory>
    <uiOrder>2100</uiOrder>
    <comps>
      <!-- <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>200</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/> -->
      <li Class="BringEmDown.RailcannonCompProps" />
    </comps>
    <designationHotKey>Misc3</designationHotKey>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>MicroelectronicsBasics</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
  </ThingDef>

  <!-- Cargo crates -->

  <ThingDef ParentName="CrateBase">
    <defName>BED_ExpensiveCargoCrate</defName>
    <label>expensive cargo crate</label>
    <description>A vacuum-sealed cargo crate for storing expensive artifacts and tech on trade ships on prolonged interstellar voyages. \n\nDesigned for maximum security, this crate will require quite a bit of hacking to get in.</description>
    <thingClass>BringEmDown.BEDCargoCrate</thingClass>
    <graphicData>
      <texPath>Building/ExpensiveCargoCrate/ExpensiveCargoCrate_closed</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(0.8,0.25,0.8)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <blockWind>false</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <fillPercent>0.5</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <statBases>
      <MaxHitPoints>7500</MaxHitPoints>
      <Flammability>0.6</Flammability>
    </statBases>
    <size>(1,1)</size>
    <building>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
      <paintable>true</paintable>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
      <neverBuildable>true</neverBuildable>
    </building>
    <defaultPlacingRot>North</defaultPlacingRot>
    <hasInteractionCell>false</hasInteractionCell>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <comps>
      <li Class="CompProperties_EmptyStateGraphic">
        <graphicData>
          <texPath>Building/ExpensiveCargoCrate/ExpensiveCargoCrate_open</texPath>
          <graphicClass>Graphic_Single</graphicClass>
          <drawSize>(1,1)</drawSize>
        </graphicData>
      </li>
      <li Class="CompProperties_Hackable">
        <defence>50000</defence>
        <effectHacking>HackingTerminal</effectHacking>
        <notHackedInspectString>Hack to unlock the crate.</notHackedInspectString>
      </li>
    </comps>
  </ThingDef>

  <!-- Large cargo container -->

  <ThingDef ParentName="CrateBase">
    <defName>BED_LargeCargoContanier</defName>
    <label>large cargo crate</label>
    <description>A generic shipping container for storing mid to low value cargo on prolonged interstellar voyages.</description>
    <thingClass>BringEmDown.LargeCargoCrate</thingClass>
    <graphicData>
      <texPath>Building/LargeCargoCrate/cargoContainer_Closed</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,5)</drawSize>
      <shadowData>
        <volume>(2,2,4)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <pathCost>50</pathCost>
    <blockWind>true</blockWind>
    <fillPercent>1.0</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <statBases>
      <MaxHitPoints>5000</MaxHitPoints>
      <Flammability>0.6</Flammability>
    </statBases>
    <size>(3,5)</size>
    <building>
      <openingStartedSound>BuildingDestroyed_Metal_Big</openingStartedSound>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
      <paintable>true</paintable>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
      <neverBuildable>true</neverBuildable>
    </building>
    <defaultPlacingRot>North</defaultPlacingRot>
    <hasInteractionCell>false</hasInteractionCell>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <comps>
    <!--No CompProperties_EmptyStateGraphic since it was kinda pissy about being colored so i just added it's functionality to thingClass -->
      <li>
        <compClass>CompColorable</compClass>
      </li>
    </comps>
  </ThingDef>

