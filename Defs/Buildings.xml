  <ThingDef ParentName="ShipChunkBase">
    <defName>BED_LargeShipChunnk</defName>
    <label>large ship chunk</label>
    <description>A chunk of a spacecraft. It seems to have been torn off either by uncontrolled re-entry forces or some kind of weapon.\n\nHaving landed not long ago, it still contains useful resources which you can acquire by deconstructing it.</description>
    <category>Building</category>
    <graphicData>
      <texPath>Building/LargeSpaceshipChunk</texPath>
      <shaderType>CutoutComplex</shaderType>
      <graphicClass>Graphic_Random</graphicClass>
      <drawSize>(3,3)</drawSize>
      <damageData>
        <rect>(0.1,0.1,1.8,1.8)</rect>
      </damageData>
      <shadowData>
        <volume>(2.39,1.5,2.25)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <pathCost>42</pathCost>
    <blockWind>true</blockWind>
    <passability>Impassable</passability>
    <fillPercent>1.00</fillPercent>
    <size>(3,3)</size>
    <statBases>
      <MaxHitPoints>1000</MaxHitPoints>
      <Flammability>0</Flammability>
      <Beauty>-30</Beauty>
      <WorkToBuild>24000</WorkToBuild>
    </statBases>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <killedLeavings>
      <ChunkSlagSteel>5</ChunkSlagSteel>
       <Steel>140</Steel>
      <ComponentIndustrial>16</ComponentIndustrial>
    </killedLeavings>
    <building inherit=False>
      <claimable>false</claimable>
      <alwaysDeconstructible>false</alwaysDeconstructible>
    </building>
    <selectable>true</selectable>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <drawerType>MapMeshOnly</drawerType>
    <repairEffect>ConstructMetal</repairEffect>
    <comps inherit=False>
      <li Class="CompProperties_InspectString">
        <inspectString>Destroy for valuable resources.</inspectString>
      </li>
      <li>
        <compClass>CompColorable</compClass>
      </li>
    </comps>
  </ThingDef>
</Defs>