  <ThingDef ParentName="BuildingBase">
    <defName>BED_OrbitalRailcannon</defName>
    <label>orbital railcannon</label>
    <description>TBD</description>
    <graphicData>
      <texPath>placeholderpng</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
      <damageData>
        <rect>(0,0,3,1.8)</rect>
