    <MapGeneratorDef ParentName="MapCommonBase">
        <defName>BED_Ship_mapGenerator</defName>
        <label>custom map generator</label>
        <genSteps>
            <li>BED_GenStep_ScatterSteelSlag</li>
            <li>BED_GenStep_ScatterShipChunks</li>
            <li>BED_GenStep_SpawnSurvivors</li>
            <li>BED_GenStep_ScatterGoods</li>
        </genSteps>
    </MapGeneratorDef>

  <GenStepDef>  
    <defName>BED_GenStep_ScatterSteelSlag</defName>
    <order>480</order>
    <genStep Class="GenStep_ScatterThings">
      <thingDef>ChunkSlagSteel</thingDef>
      <countPer10kCellsRange>10.0~20.0</countPer10kCellsRange>
    </genStep>
  </GenStepDef>

  <GenStepDef>
    <defName>BED_GenStep_ScatterShipChunks</defName>
    <order>500</order>
    <genStep Class="GenStep_ScatterThings">
      <thingDef>ShipChunk</thingDef>
      <countPer10kCellsRange>5.0~10.0</countPer10kCellsRange>
    </genStep>
  </GenStepDef>

  <GenStepDef>
    <defName>BED_GenStep_SpawnSurvivors</defName>
    <order>400</order>
    <genStep Class="BringEmDown.GenerateSurvivors" />
  </GenStepDef>

  <GenStepDef>
    <defName>BED_GenStep_ScatterGoods</defName>
    <order>510</order>
    <genStep Class="BringEmDown.ScatterGoods" />
  </GenStepDef>

